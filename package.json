{
  "name": "tatami-scoreboard",
  "author": "Nikita Ivanyushkin",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write src e2e eslint.config.js package.json tsconfig.json tsconfig.eslint.json src-tauri/tauri.conf.json src-tauri/capabilities",
    "format:check": "prettier --check src e2e eslint.config.js package.json tsconfig.json tsconfig.eslint.json src-tauri/tauri.conf.json src-tauri/capabilities",
    "lint": "eslint src e2e vite.config.ts",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tsparticles/plugin-emitters": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "@tsparticles/updater-wobble": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@linaria/vite": "^5.0.4",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
